# Copy this file to `.streamlit/secrets.toml` for local runs, or paste its
# contents into Streamlit Community Cloud → Settings → Secrets.
# (.streamlit/secrets.toml itself is git-ignored so real keys never get committed.)
#
# Get a free Gemini API key at https://aistudio.google.com → "Get API key".
# A Gemini key starts with "AIza...".
GEMINI_API_KEY = "AIza..."
